# Required: local Redis used by the matching API and LTA worker.
REDIS_URL=redis://localhost:6379/0

# Optional overrides for local development.
POLLING_INTERVAL_SECONDS=600
REDIS_SNAPSHOT_TTL_SECONDS=600
MATCHING_SEARCH_RADIUS_KM=5
MATCHING_CANDIDATE_COUNT=50
MATCHING_RESERVATION_TTL_SECONDS=60
MATCHING_MAX_RETRIES=3
MATCHING_RETRY_SECONDS=5
